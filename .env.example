# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Public hostname Traefik routes /wiki* to. Unused by compose.dev.yml.
WIKI_DOMAIN=wiki.uprzejmiedonosze.net

# authud plugin (conf/local-prod.php, generated at container boot - see
# docker/entrypoint.sh). Real values live only in the deploy host's .env,
# same as they used to live only in the gitignored conf/local-prod.php.
AUTHUD_ENDPOINT=https://uprzejmiedonosze.net/user/validate
AUTHUD_APIKEY=changeme

# DokuWiki superuser group/user, ACL syntax (e.g. "@admin" or a username).
WIKI_SUPERUSER=@admin

# WIKI_DATA_SOURCE=/opt/wiki/data
# WIKI_DATA_RO=1

# Same idea for conf/ (acl.auth.php, users.auth.php - the latter isn't
# tracked in git at all, so a fresh named volume never has it). No _RO
# variant: unlike data/, conf/ is meant to be written by this container
# alone once migrated (ACL Manager plugin, authud user creation).
# WIKI_CONF_SOURCE=/opt/wiki/conf
